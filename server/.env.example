NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed by CORS.
# Defaults to http://localhost:3000 when unset. Use * only to allow everything.
# CORS_ORIGIN=http://localhost:3000
MONGODB_URL=mongodb+srv://...
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com

# Resend (production email delivery)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=Stack Overflow Clone <no-reply@yourdomain.com>

RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret

# Optional during local development. If blank, phone OTP features use an email fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
